  "target": {
    "citation": "van Can JGP, van Loon LJC, Brouns F, Blaak EE. Reduced glycaemic and insulinaemic responses following trehalose and isomaltulose ingestion: implications for postprandial substrate use in impaired glucose-tolerant subjects. Br J Nutr 2012;108:1210-1217.",
    "doi": "10.1017/S0007114511006714",
    "design": "randomised single-blind crossover; ten overweight IGT subjects (6 men, 4 women) each 'studied four times' (GLUC, TRE, SUC, IMU), 1-week washout; on each trial day the same sugar drink was taken after an overnight fast (breakfast, 08.45) and again with a standardised mixed lunch (12.30)",
    "all_four_conditions_verified": "Methods: 'Each subject participated in four trials'; Abstract: 'ten overweight IGT subjects were studied four times'",
    "dose_text": "'The CHO load consisted of 75 g CHO equivalents and was dissolved in 400 ml of water'; lunch: '25 En% of the total energy content of the meal was provided in the form of a beverage containing either TRE, IMU, GLUC or SUC'",
    "dose_ambiguity": "Whether the lunch beverage was 75 g or 25 En% of an individualised lunch is not reconciled in the text; the mass basis of 'CHO equivalents' for trehalose and isomaltulose (anhydrous vs hydrate) is not stated",
    "sampling": "venous, t = -5 (baseline), 30, 60, 90, 120, 150, 180 min after ingestion; no 15 or 45 min samples",
    "assay": "plasma insulin, double-antibody RIA (Linco Research)",
    "operator": "'incremental area under the curve (iAUC) ... calculated by the trapezoid method'; handling of area below baseline not stated",
    "statistics": "paired t-tests only within GLUC v. TRE and SUC v. IMU; 'The four CHO were not compared with each other'",
    "unit_printed": "uU/ml over 3 h",
    "conversion_printed": "To convert insulin from uU/ml to pmol/l, multiply by 6",
    "dispersion": "Tables 2 and 3 print means only (no SE)",
