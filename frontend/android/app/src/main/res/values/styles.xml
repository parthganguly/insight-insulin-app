<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Post-splash theme (issue #107). The window background must be an
         explicit opaque Porcelain surface so no transparent or black frame can
         appear between splash dismissal and the first WebView paint.
         startup_porcelain_surface is day/night qualified. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/startup_porcelain_surface</item>
    </style>


    <!-- Launch theme (issue #107): modern splash contract. The splash surface
         is OS-matched Porcelain; the existing static splash artwork is reused
         unchanged as the splash icon. MainActivity holds this splash until the
         web shell reports readiness (6 s fail-open). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/startup_porcelain_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
